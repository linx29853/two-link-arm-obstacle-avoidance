<mujoco model="armlab_horizontal_two_link">
  <!-- SI units. q1 is relative to world +X; q2 is relative to link1.
       Both joints rotate about +Z. These are teaching parameters, not measurements. -->
  <compiler angle="radian" inertiafromgeom="auto"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <default>
    <joint type="hinge" axis="0 0 1" limited="true"
           range="-2.6179938779914944 2.6179938779914944"
           damping="0.02" armature="0" frictionloss="0"/>
    <geom friction="0.5 0.005 0.0001"/>
    <motor ctrllimited="true" ctrlrange="-1 1" gear="1"/>
    <site size="0.006" rgba="0.1 0.9 0.2 1"/>
  </default>

  <visual>
    <global offwidth="800" offheight="600"/>
  </visual>

  <worldbody>
    <light pos="0.2 -0.3 1.5" dir="0 0 -1" directional="true"/>
    <camera name="top" pos="0.275 0 1.2" xyaxes="1 0 0 0 1 0"/>
    <geom name="floor" type="plane" size="0.8 0.8 0.01" rgba="0.18 0.22 0.27 1"/>
    <geom name="base_visual" type="cylinder" pos="0 0 0.035" size="0.025 0.035"
          rgba="0.45 0.48 0.52 1" contype="0" conaffinity="0"/>

    <!-- The vertical cylinder intersects the arm's horizontal z=0.08 plane.
         Its XY cross-section matches the original circular obstacle. -->
    <geom name="obstacle" type="cylinder" pos="0.15 0.08 0.08" size="0.04 0.04"
          rgba="0.9 0.25 0.15 1"/>

    <body name="link1" pos="0 0 0.08">
      <joint name="q1"/>
      <!-- Uniform cylinder: mass 0.30 kg, length 0.30 m, radius 0.01 m.
           MuJoCo derives the center of mass and full inertia from this geom. -->
      <geom name="rod1" type="cylinder" fromto="0 0 0 0.30 0 0"
            size="0.01" mass="0.30" rgba="0.15 0.45 0.9 1"/>
      <site name="shoulder" pos="0 0 0"/>

      <body name="link2" pos="0.30 0 0">
        <joint name="q2"/>
        <geom name="rod2" type="cylinder" fromto="0 0 0 0.25 0 0"
              size="0.01" mass="0.25" rgba="0.95 0.65 0.1 1"/>
        <site name="elbow" pos="0 0 0"/>
        <site name="tip" pos="0.25 0 0"/>
      </body>
    </body>
  </worldbody>

  <contact>
    <!-- Adjacent links share a joint; this model omits their mutual contact. -->
    <exclude body1="link1" body2="link2"/>
  </contact>

  <actuator>
    <!-- gear=1: ctrl is joint torque in N*m. Limits are teaching assumptions. -->
    <motor name="torque1" joint="q1"/>
    <motor name="torque2" joint="q2"/>
  </actuator>
</mujoco>
